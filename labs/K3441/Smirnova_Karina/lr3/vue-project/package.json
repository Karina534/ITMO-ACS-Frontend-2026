{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "json-server-auth db.json -r routes.json --port 3001",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.6",
    "json-server": "^0.17.4",
    "json-server-auth": "^2.1.0",
    "oxfmt": "^0.67.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.1"
  }
}
